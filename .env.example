# Copy to .env and fill in. Nothing here has a safe default except ORIGIN
# in development, so bootstrap.js refuses to start without DATABASE_URL.

# Required. Postgres 18. Use the direct endpoint, not a pooled one: this
# app keeps its own pool (see src/lib/server/db/index.ts) and the pooled
# endpoint does not reliably pick up `alter role ... set search_path`.
DATABASE_URL=postgresql://user:password@localhost:5432/rehearsal

# Required in production. The host that goes inside emailed links, and the
# origin adapter-node checks form posts against. Not the request's own
# host: an email is read from anywhere, so the link needs a host that
# means something there.
ORIGIN=http://localhost:3000

# Required to send anything. Verification links, edit tokens, the day-11
# renewal nudge, and report notifications all go through Resend.
RESEND_API_KEY=

# Optional. Defaults to Resend's keyless sandbox sender, which only
# delivers to the Resend account owner. Point this at a verified domain
# before real traffic.
MAIL_FROM=Proba <noreply@proba.gr>

# Where ad reports are emailed. Unset means reports are still recorded in
# the `report` table, but only a console warning tells you one arrived.
ADMIN_EMAIL=

# Optional. Salts the hashes of visitor IPs used for view counting and
# report deduplication. Raw IPs are never stored. Rotating this
# invalidates every existing hash, which resets those windows.
IP_SALT=
